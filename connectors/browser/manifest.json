{
  "manifest_version": 3,
  "name": "Dockly Connector",
  "version": "1.2.0",
  "description": "Add the current page, any link or all open tabs to Dockly as web shortcuts.",
  "permissions": ["activeTab", "contextMenus", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "add-page": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Add this page to Dockly" },
    "add-tabs": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "Add all tabs in this window to Dockly" }
  },
  "action": { "default_title": "Add to Dockly", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
